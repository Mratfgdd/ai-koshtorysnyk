# Copy to deploy.env (gitignored) and fill in.
# deploy.env must never be committed.

# The SSH host — NOT your email. Find it in cPanel, top-right, or in the
# welcome email from HostIQ. Usually srvNN.hostiq.ua or a bare IP.
SSH_HOST=srvNN.hostiq.ua

# The cPanel username, which is usually NOT the email you log in with.
# cPanel shows it in the right-hand "General information" panel.
SSH_USER=

# HostIQ often uses a non-standard SSH port on shared plans.
SSH_PORT=22

# Public URL of the backend, no trailing slash.
API_URL=https://api.example.com

APP_DIR=koshtorysnyk
WEB_DIR=public_html
