# Backend environment for HostIQ. Set these in cPanel -> Setup Python App ->
# Environment variables (preferred), or in a .env file in the app root.

ANTHROPIC_API_KEY=

AI_MODEL=claude-opus-5
AI_EFFORT=high

# Shared hosting is CPU- and memory-limited. 2-3 parallel page analyses is
# realistic; 6 will trip the LVE limits and the process gets killed mid-run.
AI_MAX_CONCURRENCY=2

# Must stay BELOW the web-server limit in .htaccess / .user.ini (200M), so the
# app returns a clean 413 instead of the connection being cut.
MAX_UPLOAD_MB=150

# Rendering at 130 DPI is already conservative; lower it if memory is tight.
PAGE_RENDER_DPI=110
PAGE_RENDER_MAX_PX=1400
MAX_VISION_PAGES=30

# Frontend origin, so the browser is allowed to call this API.
CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOW_VERCEL=false

# Storage inside the app directory (cPanel accounts have a disk quota).
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/estimator.db

DEBUG=false
