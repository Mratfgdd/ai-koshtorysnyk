# Copy to .env and fill in. Never commit the real file.

# --- AI ----------------------------------------------------------------------
# Required only for automatic document analysis. Everything else -- catalog,
# template rules, calculations, validation, Excel export -- works without it.
ANTHROPIC_API_KEY=

# Model used for page and object analysis.
AI_MODEL=claude-opus-5
AI_EFFORT=high
AI_MAX_TOKENS=16000

# Pages analysed in parallel. Raise for speed, lower if you hit rate limits.
AI_MAX_CONCURRENCY=6

# Set to false to run the system with no AI calls at all.
AI_ENABLED=true

# --- Document processing -----------------------------------------------------
# Resolution used when rendering a raster drawing for visual analysis.
PAGE_RENDER_DPI=130
PAGE_RENDER_MAX_PX=1600

# Hard cap on how many pages of one upload get a (paid) visual analysis.
# Pages carrying quantities -- schedules and plans -- are prioritised.
MAX_VISION_PAGES=40

MAX_UPLOAD_MB=400

# --- Storage -----------------------------------------------------------------
# Defaults to SQLite under ./data. Point at PostgreSQL for a shared deployment.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/estimator

DEBUG=false

# --- deployment --------------------------------------------------------------
# Render supplies PORT automatically; set it only when running elsewhere.
# PORT=8000

# Extra browser origins allowed to call the API, comma-separated.
# Any *.vercel.app deployment is allowed by default, so preview builds work
# without redeploying the backend. Add a custom domain here.
# CORS_ORIGINS=https://kp.example.com
# CORS_ALLOW_VERCEL=true

# Where the database and uploads live. On Render point this at the mounted disk.
# DATA_DIR=/var/data
# DATABASE_URL=sqlite:////var/data/estimator.db
